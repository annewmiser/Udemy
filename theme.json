{
    "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "color": {
            "defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
            "background": true,
            "text": true,
            "link": true,
            "custom": true,
            "button": true,
            "heading": false,
            "caption": false,
            "palette": [
            {"slug": "u-white","color": "rgb(255 255 255)","name": "Udemy White"},
            { "slug": "u-gray-100", "color": "rgb(243 244 246)", "name": "Udemy Gray 100" },
            { "slug": "u-gray-200", "color": "rgb(229 231 235)", "name": "Udemy Gray 200" },
            { "slug": "u-gray-300", "color": "rgb(209 213 219)", "name": "Udemy Gray 300" },
            { "slug": "u-gray-400", "color": "rgb(156 163 175)", "name": "Udemy Gray 400" },
            { "slug": "u-gray-500", "color": "rgb(107 114 128)", "name": "Udemy Gray 500" },
            { "slug": "u-gray-600", "color": "rgb(75 85 99)", "name": "Udemy Gray 600" },
            { "slug": "u-gray-700", "color": "rgb(55 65 81)", "name": "Udemy Gray 700" },
            { "slug": "u-gray-800", "color": "rgb(31 41 55)", "name": "Udemy Gray 800" },
            { "slug": "u-gray-900", "color": "rgb(17 24 39)", "name": "Udemy Gray 900" },
            { "slug": "u-primary", "color": "rgb(239 68 68)", "name": "Udemy Primary" },
            { "slug": "u-accent", "color": "rgb(67 56 202)", "name": "Udemy Accent" },
            { "slug": "u-success", "color": "rgb(52 211 153)", "name": "Udemy Success" },
            { "slug": "u-info", "color": "rgb(96 165 250)", "name": "Udemy Info" },
            { "slug": "u-warning", "color": "rgb(251 146 60)", "name": "Udemy Warning" },
            { "slug": "u-danger", "color": "rgb(236 72 153)", "name": "Udemy Danger" }
            ],
            "duotone": [
                {"slug": "u-pink-sunset","colors": ["#11245e" , "#dc4379"],"name": "Udrmy Pink Sunset"},
                {"slug": "u-red-sunset","colors": ["#FF416C " , "#FFB347"],"name": "Udrmy red Sunset"}
            ],
            "gradients": [
                {"slug": "u-summer-dog","name": "Udemy Summer Dog","gradient": "linear-gradient(#a8ff78,#78ffd6)"},
                {"slug": "u-random-dog","name": "Udemy Ramdom Dog","gradient": "linear-gradient(217deg, rgb(255 0 0 / 0.8), transparent 70.71%),linear-gradient(127deg, rgb(0 255 0 / 0.8), transparent 70.71%),linear-gradient(127deg, rgb(0 255 0 / 0.8), transparent 70.71%)"}

            ]
        },
        "blocks": {
            "core/site-title": {
                "color": {
                    "defaultPalette": true,
                    "palette": [{
                        "slug": "u-primary","color": "#ef4444", "name": "Udemy Primary"
                    }
                ],
                "link": true,
                "custom": true,
                "gradients": [  {"slug": "u-summer-dog","name": "Udemy Summer Dog","gradient": "linear-gradient(#a8ff78,#78ffd6)"},
                {"slug": "u-random-dog","name": "Udemy Ramdom Dog","gradient": "linear-gradient(217deg, rgb(255 0 0 / 0.8), transparent 70.71%),linear-gradient(127deg, rgb(0 255 0 / 0.8), transparent 70.71%),linear-gradient(127deg, rgb(0 255 0 / 0.8), transparent 70.71%)"}],
                "customGradient": true
                },
            "typography": {
                "fontFamilies": [
                {
                "fontFamily": "Pacifico, sans-serif", 
                "slug": "u-pacifico",
                "name": "Udemy Pacifico"
            }
            ]
        }

            },
            "core/cover": {
                "color": {
                    "duotone": [{"slug": "u-pink-sunset","colors": ["#11245e" , "#dc4379"],"name": "Udrmy Pink Sunset"}],
                    "customDuotone": true
                }

            },
            "core/preformatted": {
                "typography": {
                    
                    "fontSizes": [],
                    "customFontSize": false
                }
            }
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "typography": {
            "defaultFontSizes": false,
            "fontFamilies": [
                {"fontFamily": "Rubik , sans-serif", 
                "slug": "u-Rubik",
                "name": "Udemy Rubik"
            }
            ],
            "fontSizes": [           
            {
                    "slug": "small",
                    "size": "0.75rem",
                    "name": "Small"
            },
             {
                    "slug": "medium",
                    "size": "1.25rem",
                    "name": "Medium"
            },
             {
                    "slug": "large",
                    "size": "2.25rem",
                    "name": "Large"
            },
             {
                    "slug": "x-large",
                    "size": "3rem",
                    "name": "X-large"
            },
             {
                    "slug": "xx-large",
                    "size": "3.75rem",
                    "name": "XX-large"
            }
            ],
            "lineHeight": true,
            "dropCap": true,
            "fontStyle": true,
            "fontWeight": true, 
            "textTransform": true,
            "textDecoration": true,
            "letterSpacing": true
            
        },
        "layout": {
            "contentSize": "800px",
            "wideSize": "1200px"
        },
        "spacing": { 
            "margin": true,
            "padding": true,
            "units": [
                "px",
                "em",
                "rem",
                "vh",
                "vw",
                "%"
            ],
            "blockGap": true

        }

    },
    "styles": {
        "color": {
            "text": "var(--wp--preset--color--pale-pink)",
            "background":"var(--wp--preset--color--u-gray-900)"
        },
        "elements": {
            "link" : {
                "color": {
                    "text":"var(--wp--preset--color--vivid-cyan-blue)"
                },
                ":hover":{
                    "color": {
                        "text":"var(--wp--preset--color--pale-cyan-blue)"
                    }

                }
            }
            
        },
        "blocks": {
            "core/button": {
                "color": {
                    "gradient": "var(--wp--preset--gradient--u-summer-dog)",
                    "text":"var(--wp--preset--color--vivid-red)"
                }
            },
            "core/pullquote" : {
                "border": {
                    "width":"2px",
                    "color":"var(--wp--preset--color--u-primary)",
                    "style":"solid",
                    "radius":"10px"
                }
            },
            "core/site-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--u-pacifico)"
                }
            }
        },
        "typography": {
            "fontFamily":  "var(--wp--preset--font-family--u-rubik)",
            "fontSize":"16px",
            "fontStyle":"normal",
            "fontWeight":"normal",
            "lineHeight":"inherit",
            "textDecoration":"none",
            "textTransform":"none"

                
            

            
        },
        "spacing": {
            "margin": {
                "top":"0px",
                "bottom":"0px",
                "left":"0px",
                "right":"0px"
            },
            "padding": {
                "top":"0px",
                "bottom":"0px",
                "left":"0px",
                "right":"0px"
            },
            "blockGap": "4rem"
        }

    }
}